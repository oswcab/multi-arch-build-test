# Optional local overrides. Copy to .konflux-test.env and fill locally; never
# commit the copy. Exported environment variables take precedence, and the file
# is not required when every value is already exported.
# KUBECONFIG may be one file or a colon-separated list of files.
KUBECONFIG=/absolute/path/to/kubeconfig
# Expected API server guard, for example the output of `oc whoami --show-server`.
KONFLUX_CLUSTER_SERVER=
GITHUB_TOKEN=
GITLAB_BOT_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4
